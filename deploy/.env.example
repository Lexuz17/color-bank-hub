# Copy to .env next to docker-compose.yml on the VPS, fill in, then: chmod 600 .env
# Never commit the real .env.

WEB_ORIGIN=https://colorbank.example.com
BETTER_AUTH_URL=https://colorbank.example.com

# Image version to run: latest, or a commit SHA to roll back.
IMAGE_TAG=latest

POSTGRES_DB=color_bank_hub
POSTGRES_USER=color_bank
POSTGRES_PASSWORD=replace_with_a_long_random_password

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_random_secret
# One domain only. Anyone with this domain can create an account (it stays pending until an admin activates it).
ALLOWED_EMAIL_DOMAIN=example.com
# Redirect URI in Google Cloud Console: https://<SITE_DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret

# Cloudflare R2. The bucket CORS must allow the origin https://<SITE_DOMAIN>.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=color-bank-staging
S3_ACCESS_KEY_ID=replace_with_access_key_id
S3_SECRET_ACCESS_KEY=replace_with_secret_access_key
