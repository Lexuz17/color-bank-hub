# One address for web and API. With SITE_DOMAIN set to a domain, Caddy gets the HTTPS certificate itself; with ":80" it serves plain HTTP behind another proxy.
{$SITE_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	# The SPA: any other path serves index.html, so a refresh on /shade-mapping works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
