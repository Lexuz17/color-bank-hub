# One domain for web and API. Caddy gets and renews the HTTPS certificate by itself.
{$SITE_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	# The SPA: any other path serves index.html, so a refresh on /shade-mapping works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
