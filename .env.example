# Runtime mode. `pnpm dev` sets development; Docker Compose defaults to production.
NODE_ENV=development

# API server
PORT=3000
HOST=localhost

# Web dev server. Keep WEB_HOST and WEB_ORIGIN on the same host.
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_BASE_URL=/api

# PostgreSQL (host published port and container port)
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=color_bank_hub
POSTGRES_USER=color_bank
POSTGRES_PASSWORD=replace_with_a_strong_password
# Host-side URL for the API and db scripts. Docker Compose overrides it to use the db service.
DATABASE_URL=postgresql://color_bank:replace_with_a_strong_password@localhost:5432/color_bank_hub

# Object storage
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=color-bank-dev
S3_ACCESS_KEY_ID=replace_with_access_key_id
S3_SECRET_ACCESS_KEY=replace_with_secret_access_key

# Better Auth and Google OAuth. Google OAuth is optional in development and required outside development.
BETTER_AUTH_SECRET=replace_with_a_random_32_character_secret
BETTER_AUTH_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=example.com
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret
