{
  "name": "api",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "typecheck": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "node --env-file-if-exists=../../.env --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@color-bank-hub/contracts": "workspace:*",
    "@color-bank-hub/db": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^9.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
